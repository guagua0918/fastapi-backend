DATABASE_URL=postgresql://dev_user:your_password@localhost:5433/fastapi_dev
# 公開在 IIS 子路徑時填學號目錄，本機測試 Swagger 可先留空
# ROOT_PATH=/s學號
ROOT_PATH=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://demo.wke.csie.ncnu.edu.tw/s學號/api/auth/google/callback
JWT_SECRET_KEY=replace-with-a-long-random-secret
SESSION_SECRET_KEY=replace-with-a-different-long-random-secret
AUTH_COOKIE_SECURE=true
ACCESS_TOKEN_EXPIRE_SECONDS=28800
AUTH_SUCCESS_REDIRECT_URL=https://demo.wke.csie.ncnu.edu.tw/s學號/
